SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
DATABASE_URL=postgresql+psycopg://auditflow:auditflow@db:5432/auditflow
DEMO_MODE=true
MAX_UPLOAD_MB=20
TESSERACT_CMD=
MALWARE_SCANNER=
POSTGRES_PASSWORD=auditflow
# Optional: enable exact-source quote selection by an external model.
# Retrieved passages are sent to Anthropic only when both values are configured.
ANTHROPIC_API_KEY=
LLM_MODEL=
# Optional local semantic model directory or cached Sentence Transformers model ID.
EMBEDDING_MODEL=
ALLOW_MODEL_DOWNLOAD=false
